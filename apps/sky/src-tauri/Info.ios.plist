<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged by Tauri into the generated Info.plist of the iOS app. -->
<plist version="1.0">
<dict>
    <!-- Keep running with the screen locked: GPS tracking and vario tone. -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
        <string>location</string>
    </array>

    <!-- Texts shown in the permission dialogs. -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Die Position wird für Karte, Geschwindigkeit und die Aufzeichnung des Flugs verwendet.</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>Damit der Flug auch bei gesperrtem Bildschirm aufgezeichnet wird, braucht die App den Standortzugriff „Immer“.</string>
    <key>NSMotionUsageDescription</key>
    <string>Luftdruck und Beschleunigung werden für das Variometer verwendet.</string>

    <!-- Make the app's Documents folder (sensor logs, later IGC files) visible in the Files app. -->
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>

    <!-- Downloading map regions from ZeroGrid Base on the desktop in the home
         network: the text of the local network permission dialog iOS shows on the
         first connection. (No App Transport Security exception is needed: the download
         runs in Rust on plain sockets, which ATS does not cover.) -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Lädt Kartenregionen von ZeroGrid Base am Computer im Heimnetz.</string>

    <!-- Scanning the QR code of the share of ZeroGrid Base. -->
    <key>NSCameraUsageDescription</key>
    <string>Liest den QR-Code der Freigabe in ZeroGrid Base.</string>
</dict>
</plist>
